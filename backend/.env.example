# ─────────────────────────────────────────────────────────────
# Royal Bee Film Studios — backend environment variables
# Copy this file to `.env` and fill in real values.
# NEVER commit your real .env file.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=http://localhost:5173
# Public URL of this API (used in emails / links)
SERVER_URL=http://localhost:5000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/royal_bee_studios

# Auth — generate long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7
# 64 hex characters (32 bytes) used to encrypt MFA secrets at rest
MFA_ENCRYPTION_KEY=replace_with_64_hex_characters
# Require MFA for roles marked "requiresMfa" (Super Admin by default). Keep true in production.
MFA_ENFORCE=true
INVITE_EXPIRES_HOURS=72
RESET_EXPIRES_MINUTES=30
# Cookie settings — set COOKIE_SECURE=true when served over HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Cloudinary (media uploads) — leave blank to run in "setup required" state
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=royal-bee

# Brevo (email) — leave blank to log emails instead of sending
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=hello@yourstudiodomain.com
EMAIL_FROM_NAME=Royal Bee Film Studios
# Where new enquiry / contact notifications go (comma separated). Can also be edited in CMS settings.
STAFF_NOTIFICATION_EMAILS=

# Seeding the first Super Admin (used by `npm run create-admin`)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_FIRST_NAME=Studio
SEED_ADMIN_LAST_NAME=Admin
