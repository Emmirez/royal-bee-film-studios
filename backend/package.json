{
  "name": "royal-bee-backend",
  "version": "0.2.0",
  "description": "Royal Bee Film Studios — API (Stage 1: foundation, Stage 2: public website & CMS)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
