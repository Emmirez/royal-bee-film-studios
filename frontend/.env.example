# Royal Bee Film Studios — frontend environment
# Copy to `.env` (optional in development).

# API base URL. In development leave as /api/v1 — Vite proxies it to the backend.
# In production set it to your deployed API, e.g. https://api.yourstudiodomain.com/api/v1
VITE_API_URL=/api/v1

# Where the dev proxy sends /api requests (development only)
VITE_BACKEND_URL=http://localhost:5000

# Optional: your Cloudinary cloud name (used only to build optimized image URLs)
VITE_CLOUDINARY_CLOUD_NAME=
